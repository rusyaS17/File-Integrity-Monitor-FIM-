<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane minWidth="1100.0" minHeight="700.0"
            styleClass="application-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kz.kaznaru.fim.desktop.controller.MainShellController">
    <left>
        <VBox minWidth="220.0" prefWidth="240.0" maxWidth="240.0"
              styleClass="sidebar">
            <padding>
                <Insets top="28.0" right="16.0" bottom="20.0" left="16.0"/>
            </padding>
            <children>
                <VBox spacing="32.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane minWidth="40.0" minHeight="40.0"
                                   prefWidth="40.0" prefHeight="40.0"
                                   styleClass="brand-mark">
                            <Label text="F" styleClass="brand-mark-letter"/>
                        </StackPane>
                        <VBox spacing="4.0">
                            <Label text="FIM SENTINEL" styleClass="brand-title"/>
                            <Label text="CYBERSECURITY // FIM"
                                   styleClass="brand-caption"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="8.0">
                        <Label text="OPERATIONS" styleClass="section-caption"/>
                        <VBox spacing="4.0" fillWidth="true">
                            <Button fx:id="dashboardButton"
                                    styleClass="nav-button"
                                    accessibleText="Dashboard">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <Label text="◈" styleClass="nav-icon"/>
                                        <Label text="Dashboard" styleClass="nav-label"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="monitoringButton" styleClass="nav-button">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <Label text="◉" styleClass="nav-icon"/>
                                        <Label text="File Monitoring" styleClass="nav-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="SOON" styleClass="coming-soon"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="scannerButton" styleClass="nav-button">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <Label text="⌕" styleClass="nav-icon"/>
                                        <Label text="File Scanner" styleClass="nav-label"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="historyButton" styleClass="nav-button">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <Label text="▤" styleClass="nav-icon"/>
                                        <Label text="Event History" styleClass="nav-label"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="SOON" styleClass="coming-soon"/>
                                    </HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="baselineButton" styleClass="nav-button">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <Label text="⬡" styleClass="nav-icon"/>
                                        <Label text="Baseline Management"
                                               styleClass="nav-label"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </VBox>
                    </VBox>

                    <VBox spacing="8.0">
                        <Label text="PREFERENCES" styleClass="section-caption"/>
                        <Button fx:id="settingsButton" styleClass="nav-button">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label text="⚙" styleClass="nav-icon"/>
                                    <Label text="Settings" styleClass="nav-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="SOON" styleClass="coming-soon"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </VBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="8.0" styleClass="sidebar-footer">
                    <Separator/>
                    <Label text="LOCAL INTEGRITY MONITOR"
                           styleClass="footer-caption"/>
                    <Label text="Java 17  ·  Desktop"
                           styleClass="footer-value"/>
                </VBox>
            </children>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <padding>
                <Insets top="12.0" right="32.0" bottom="12.0" left="32.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0"
                          styleClass="status-chip">
                        <Circle fx:id="systemStatusIndicator" radius="4.0"
                                styleClass="status-indicator"/>
                        <VBox spacing="2.0">
                            <Label text="SYSTEM" styleClass="status-caption"/>
                            <Label fx:id="systemStatusValue"
                                   text="READY" styleClass="status-value"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8.0"
                          styleClass="status-chip">
                        <Circle fx:id="monitoringStatusIndicator" radius="4.0"
                                styleClass="status-indicator"/>
                        <VBox spacing="2.0">
                            <Label text="MONITORING" styleClass="status-caption"/>
                            <Label fx:id="monitoringStatusValue"
                                   text="STOPPED" styleClass="status-value"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8.0"
                          styleClass="status-chip">
                        <Circle fx:id="databaseStatusIndicator" radius="4.0"
                                styleClass="status-indicator"/>
                        <VBox spacing="2.0">
                            <Label text="DATABASE" styleClass="status-caption"/>
                            <Label fx:id="databaseStatusValue"
                                   text="READY" styleClass="status-value"/>
                        </VBox>
                    </HBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <Label text="LOCAL TIME" styleClass="status-caption"/>
                    <HBox alignment="BASELINE_RIGHT" spacing="8.0">
                        <Label fx:id="localClockValue"
                               text="--:--:--" styleClass="clock-value"/>
                        <Label fx:id="localDateValue"
                               text="---, -- ---" styleClass="clock-date"/>
                    </HBox>
                </VBox>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentHost" styleClass="screen-host"/>
    </center>
</BorderPane>
