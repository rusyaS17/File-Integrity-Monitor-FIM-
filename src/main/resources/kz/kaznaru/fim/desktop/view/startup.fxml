<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18.0"
      style="-fx-background-color: #070b12;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.kaznaru.fim.desktop.controller.DesktopStartupController">
    <padding>
        <Insets top="48.0" right="48.0" bottom="48.0" left="48.0"/>
    </padding>
    <Label text="FIM SENTINEL"
           style="-fx-text-fill: #e8f4f4; -fx-font-size: 34px; -fx-font-weight: bold;"/>
    <Label text="CYBERSECURITY OPERATIONS CENTER"
           style="-fx-text-fill: #24d6c4; -fx-font-size: 16px;"/>
    <Label fx:id="initializationStatus"
           style="-fx-text-fill: #a8b7c8; -fx-font-size: 14px;"/>
</VBox>
