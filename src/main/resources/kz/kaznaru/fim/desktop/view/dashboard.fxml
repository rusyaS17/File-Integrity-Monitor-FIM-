<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            styleClass="content-scroll"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kz.kaznaru.fim.desktop.controller.DashboardController">
    <content>
        <VBox spacing="22.0" styleClass="page-content">
            <padding>
                <Insets top="30.0" right="36.0" bottom="36.0" left="36.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="SECURITY OPERATIONS" styleClass="page-eyebrow"/>
                        <Label text="Dashboard" styleClass="page-title"/>
                        <Label text="Integrity posture and persisted activity for your monitored environment."
                               wrapText="true" styleClass="page-subtitle"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="6.0">
                        <Label text="LAST SUCCESSFUL REFRESH" styleClass="panel-caption"/>
                        <Label fx:id="lastRefreshValue"
                               text="Not refreshed yet" styleClass="refresh-value"/>
                    </VBox>
                    <ProgressIndicator fx:id="dashboardProgress"
                                       prefWidth="24.0" prefHeight="24.0"
                                       maxWidth="24.0" maxHeight="24.0"
                                       visible="false" managed="false"
                                       styleClass="compact-progress"/>
                    <Button fx:id="refreshButton"
                            text="Refresh"
                            onAction="#refreshDashboard"
                            styleClass="action-button primary-action"/>
                </HBox>

                <Label fx:id="dashboardErrorLabel"
                       visible="false" managed="false"
                       wrapText="true" styleClass="error-banner"/>

                <TilePane hgap="14.0" vgap="14.0"
                          prefColumns="3"
                          prefTileWidth="280.0"
                          prefTileHeight="112.0"
                          tileAlignment="TOP_LEFT"
                          styleClass="metric-grid">
                    <children>
                        <VBox spacing="10.0" styleClass="metric-card metric-total">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="TOTAL FILES" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Σ" styleClass="metric-glyph"/>
                            </HBox>
                            <Label fx:id="totalFilesValue" text="—"
                                   styleClass="metric-value"/>
                            <Label text="All states except deleted"
                                   styleClass="metric-footnote"/>
                        </VBox>
                        <VBox spacing="10.0" styleClass="metric-card metric-safe">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="PROTECTED FILES" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="✓" styleClass="metric-glyph"/>
                            </HBox>
                            <Label fx:id="protectedFilesValue" text="—"
                                   styleClass="metric-value"/>
                            <Label text="Current SAFE state"
                                   styleClass="metric-footnote"/>
                        </VBox>
                        <VBox spacing="10.0" styleClass="metric-card metric-modified">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="MODIFIED FILES" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="!" styleClass="metric-glyph"/>
                            </HBox>
                            <Label fx:id="modifiedFilesValue" text="—"
                                   styleClass="metric-value"/>
                            <Label text="Different from baseline"
                                   styleClass="metric-footnote"/>
                        </VBox>
                        <VBox spacing="10.0" styleClass="metric-card metric-new">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="NEW FILES" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="+" styleClass="metric-glyph"/>
                            </HBox>
                            <Label fx:id="newFilesValue" text="—"
                                   styleClass="metric-value"/>
                            <Label text="Not present in baseline"
                                   styleClass="metric-footnote"/>
                        </VBox>
                        <VBox spacing="10.0" styleClass="metric-card metric-deleted">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="DELETED FILES" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="−" styleClass="metric-glyph"/>
                            </HBox>
                            <Label fx:id="deletedFilesValue" text="—"
                                   styleClass="metric-value"/>
                            <Label text="Missing from latest observed state"
                                   styleClass="metric-footnote"/>
                        </VBox>
                        <VBox spacing="10.0" styleClass="metric-card metric-threat">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="THREATS / ERRORS" styleClass="metric-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="⌁" styleClass="metric-glyph"/>
                            </HBox>
                            <Label fx:id="threatsErrorsValue" text="—"
                                   styleClass="metric-value"/>
                            <Label text="MODIFIED + ERROR"
                                   styleClass="metric-footnote"/>
                        </VBox>
                    </children>
                </TilePane>

                <HBox spacing="16.0" styleClass="dashboard-detail-row">
                    <VBox spacing="14.0" HBox.hgrow="ALWAYS"
                          styleClass="dashboard-panel activity-panel">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label text="File activity" styleClass="panel-title"/>
                                <Label text="Persisted event volume · last 24 hours · local time"
                                       styleClass="panel-subtitle"/>
                            </VBox>
                            <Label text="EVENTS / HOUR" styleClass="chart-unit"/>
                        </HBox>
                        <StackPane minHeight="235.0" prefHeight="250.0"
                                   styleClass="chart-container">
                            <LineChart fx:id="activityChart"
                                       animated="false"
                                       legendVisible="false"
                                       createSymbols="true"
                                       visible="false" managed="false"
                                       styleClass="activity-chart">
                                <xAxis>
                                    <CategoryAxis label="Local time"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Events"
                                                forceZeroInRange="true"
                                                minorTickVisible="false"/>
                                </yAxis>
                            </LineChart>
                            <Label fx:id="activityEmptyState"
                                   text="Loading persisted activity..."
                                   wrapText="true" styleClass="empty-state-copy"/>
                        </StackPane>
                    </VBox>

                    <VBox spacing="14.0" minWidth="280.0" prefWidth="310.0"
                          maxWidth="360.0" styleClass="dashboard-panel monitoring-panel">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label text="Monitoring overview" styleClass="panel-title"/>
                                <Label text="REAL-TIME WATCH SERVICE"
                                       styleClass="panel-subtitle"/>
                            </VBox>
                            <ProgressIndicator fx:id="monitoringProgress"
                                               prefWidth="22.0" prefHeight="22.0"
                                               maxWidth="22.0" maxHeight="22.0"
                                               visible="false" managed="false"
                                               styleClass="compact-progress"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0"
                              styleClass="monitoring-state-card">
                            <Circle fx:id="monitoringOverviewIndicator"
                                    radius="5.0" styleClass="status-indicator"/>
                            <VBox spacing="3.0">
                                <Label text="MONITORING STATE" styleClass="panel-caption"/>
                                <Label fx:id="monitoringStateValue"
                                       text="STOPPED" styleClass="monitoring-state-value"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="7.0">
                            <Label text="CONFIGURED ROOT" styleClass="panel-caption"/>
                            <Label fx:id="monitoredRootValue"
                                   text="Loading configured path..."
                                   wrapText="true" styleClass="path-value"/>
                        </VBox>
                        <HBox spacing="10.0" styleClass="monitoring-actions">
                            <Button fx:id="startMonitoringButton"
                                    text="Start monitoring"
                                    onAction="#startMonitoring"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="action-button primary-action"/>
                            <Button fx:id="stopMonitoringButton"
                                    text="Stop"
                                    onAction="#stopMonitoring"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    styleClass="action-button secondary-action"/>
                        </HBox>
                        <Label fx:id="monitoringErrorLabel"
                               visible="false" managed="false"
                               wrapText="true" styleClass="monitoring-error"/>
                    </VBox>
                </HBox>

                <VBox spacing="14.0" styleClass="dashboard-panel recent-events-panel">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Recent events" styleClass="panel-title"/>
                            <Label text="Latest persisted file states for this monitored root"
                                   styleClass="panel-subtitle"/>
                        </VBox>
                        <Label text="LATEST 10" styleClass="chart-unit"/>
                    </HBox>
                    <StackPane minHeight="205.0" prefHeight="250.0"
                               styleClass="events-container">
                        <TableView fx:id="recentEventsTable"
                                   visible="false" managed="false"
                                   styleClass="recent-events-table">
                            <columns>
                                <TableColumn fx:id="timeColumn" text="Time"
                                             prefWidth="150.0"/>
                                <TableColumn fx:id="filePathColumn" text="File"
                                             prefWidth="560.0"/>
                                <TableColumn fx:id="eventTypeColumn" text="Event Type"
                                             prefWidth="150.0"/>
                                <TableColumn fx:id="statusColumn" text="Status"
                                             prefWidth="130.0"/>
                            </columns>
                        </TableView>
                        <Label fx:id="recentEventsEmptyState"
                               text="Loading events..." styleClass="empty-state-copy"/>
                    </StackPane>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
