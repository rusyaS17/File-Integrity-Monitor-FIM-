<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="screen-content"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.kaznaru.fim.desktop.controller.BaselineManagementController">
    <padding>
        <Insets top="36.0" right="40.0" bottom="40.0" left="40.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="18.0">
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <Label text="TRUSTED STATE" styleClass="page-eyebrow"/>
                <Label text="Baseline Management" styleClass="page-title"/>
                <Label text="Read-only view of the configured baseline and its recovery state."
                       wrapText="true" styleClass="page-subtitle"/>
            </VBox>
            <ProgressIndicator fx:id="loadingIndicator"
                               prefWidth="22.0" prefHeight="22.0"
                               maxWidth="22.0" maxHeight="22.0"
                               visible="false" managed="false"
                               styleClass="compact-progress"/>
            <Button fx:id="refreshButton"
                    text="Refresh"
                    onAction="#refreshStatus"
                    styleClass="action-button secondary-action"/>
        </HBox>

        <Label fx:id="errorLabel"
               visible="false" managed="false"
               wrapText="true" styleClass="error-banner"/>

        <HBox alignment="CENTER_LEFT" spacing="16.0"
              styleClass="dashboard-panel baseline-status-panel">
            <VBox spacing="8.0">
                <Label text="CURRENT BASELINE STATUS" styleClass="panel-caption"/>
                <Label fx:id="statusBadge"
                       text="Loading..."
                       styleClass="baseline-status-badge baseline-status-loading"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT" spacing="8.0"
                  visible="true" managed="true">
                <Label fx:id="loadingLabel" text="Loading baseline status..."
                       styleClass="panel-subtitle"/>
            </HBox>
        </HBox>

        <VBox fx:id="statusDetails" spacing="22.0"
              visible="false" managed="false"
              styleClass="dashboard-panel baseline-details-panel">
            <GridPane hgap="40.0" vgap="24.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                </columnConstraints>
                <children>
                    <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="PRIMARY BASELINE FILE" styleClass="panel-caption"/>
                        <Label fx:id="baselinePathValue"
                               wrapText="true" styleClass="path-value baseline-data-value"/>
                    </VBox>
                    <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="BACKUP FILE" styleClass="panel-caption"/>
                        <Label fx:id="backupStatusValue" styleClass="baseline-data-value"/>
                    </VBox>
                    <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="PROTECTED FILES" styleClass="panel-caption"/>
                        <Label fx:id="protectedFilesValue"
                               styleClass="metric-value baseline-entry-count"/>
                    </VBox>
                    <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="MONITORED DIRECTORY" styleClass="panel-caption"/>
                        <Label fx:id="monitoredDirectoryValue"
                               wrapText="true" styleClass="path-value baseline-data-value"/>
                    </VBox>
                </children>
            </GridPane>
            <Label fx:id="recoveryInfo"
                   text="The primary baseline was recovered from its backup."
                   visible="false" managed="false"
                   wrapText="true" styleClass="baseline-recovery-info"/>
        </VBox>
    </children>
</VBox>
