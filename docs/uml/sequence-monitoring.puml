@startuml
actor User
participant "Console / JavaFX UI" as UI
participant MonitoringService as MS
participant FileWatcher as FW
participant EventProcessor as EP
participant HashCalculator as HC
participant IntegrityChecker as IC
database SQLite

User -> UI: Каталогты таңдау
UI -> MS: start(path)
MS -> FW: register(path)
FW --> MS: WatchService дайын
MS -> MS: Бастапқы сканерлеу және baseline құру
MS -> SQLite: Baseline сақтау
MS -> MS: Қысқа reconcile scan

... Файлдық жүйеде оқиға пайда болады ...

FW -> EP: process(path, eventKind)
EP -> EP: Файл күйін тексеру
alt Файл бар және оқуға болады
  EP -> HC: sha256(path)
  HC --> EP: currentHash
  EP -> SQLite: Baseline хэшін оқу
  SQLite --> EP: oldHash
  EP -> IC: compare(oldHash, currentHash)
  IC --> EP: NEW / MODIFIED / UNCHANGED
  EP -> SQLite: Файл күйі мен оқиғаны сақтау
else Файл жойылған
  EP -> SQLite: DELETED оқиғасын сақтау
else Файлға қол жеткізу қатесі
  EP -> SQLite: ERROR оқиғасын сақтау
end
EP --> UI: FileEvent
UI --> User: Оқиғаны көрсету
@enduml
